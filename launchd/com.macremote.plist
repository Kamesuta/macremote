<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.macremote</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/YOU/macremote/src/server.js</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOU/macremote</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MACREMOTE_PASSWORD</key><string>CHANGE-ME</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/macremote.log</string>
  <key>StandardOutPath</key><string>/tmp/macremote.log</string>
</dict>
</plist>
