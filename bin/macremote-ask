#!/usr/bin/env node
// Ask the person on the phone to do something in one window of this Mac.
//
//   macremote-ask --app "System Settings" --message "Turn on Obsidian under Accessibility" --wait
//   echo -n "$TOKEN" | macremote-ask --app "Google Chrome" --clip --message "Paste the token into the field" --wait
//
// Brings the app to the front, sends its front window's position to macremote, and prints a link
// that opens the phone viewer zoomed onto that window. --app takes the app's name as the window
// list shows it (often localized, e.g. "システム設定") or its bundle id (com.apple.systempreferences).
// --clip puts stdin on the clipboard first and clears it afterwards if it is still there.
// --wait blocks until the phone user presses Done (exit 0) or the link expires (exit 2).
//
// To point at one spot in the window: take a screenshot with --shot, look at it, then pass the
// spot as --rect x,y,w,h in that screenshot's pixels. The viewer zooms near it and outlines it.
//   macremote-ask --app Claude --shot /tmp/win.png
//   macremote-ask --app Claude --rect 1500,40,200,60 --message "Turn this switch on" --wait
import { execFileSync } from 'node:child_process';
import { readFileSync, writeFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { parseArgs } from 'node:util';

const { values: opt } = parseArgs({
  options: {
    app: { type: 'string' },
    message: { type: 'string' },
    clip: { type: 'boolean', default: false },
    shot: { type: 'string' },
    rect: { type: 'string' },
    wait: { type: 'boolean', default: false },
  },
});
if (!opt.app || (!opt.message && !opt.shot)) {
  console.error('usage: macremote-ask --app <name|bundle id> --message <text> [--rect x,y,w,h] [--clip] [--wait]\n'
    + '       macremote-ask --app <name|bundle id> --shot <file.png>');
  process.exit(64);
}

const dir = process.env.MACREMOTE_DIR ?? join(homedir(), '.macremote');
const key = process.env.MACREMOTE_SECRET ?? readFileSync(join(dir, 'secret'), 'utf8').trim();
const local = `http://127.0.0.1:${process.env.PORT ?? 8080}`;

// Activate the app and return its front window as fractions of the main screen.
const JXA = `
ObjC.import('AppKit'); ObjC.import('CoreGraphics');
function run([q]) {
  const apps = ObjC.unwrap($.NSWorkspace.sharedWorkspace.runningApplications);
  const app = apps.find((a) => ObjC.unwrap(a.localizedName) === q || ObjC.unwrap(a.bundleIdentifier) === q);
  if (!app) return JSON.stringify({ error: 'app not running: ' + q });
  app.activateWithOptions($.NSApplicationActivateAllWindows);
  delay(0.5);
  const pid = app.processIdentifier;
  const wins = ObjC.deepUnwrap(ObjC.castRefToObject($.CGWindowListCopyWindowInfo(
    $.kCGWindowListOptionOnScreenOnly | $.kCGWindowListExcludeDesktopElements, 0)));
  const w = wins.find((w) => w.kCGWindowOwnerPID === pid && w.kCGWindowLayer === 0);
  if (!w) return JSON.stringify({ error: 'no visible window for ' + q });
  const s = $.NSScreen.mainScreen.frame.size;
  return JSON.stringify({ app: ObjC.unwrap(app.localizedName), id: w.kCGWindowNumber, bounds: w.kCGWindowBounds,
    screen: { w: s.width, h: s.height }, scale: $.NSScreen.mainScreen.backingScaleFactor });
}`;

// A rectangle in screen points -> fractions of the screen, clipped to it.
function toFrac({ X, Y, Width, Height }, screen) {
  const c = (v) => Math.min(1, Math.max(0, v));
  const x = c(X / screen.w), y = c(Y / screen.h);
  return { x, y, w: c((X + Width) / screen.w) - x, h: c((Y + Height) / screen.h) - y };
}

function publicBase() {
  if (process.env.MACREMOTE_URL) return process.env.MACREMOTE_URL.replace(/\/$/, '');
  // Find the tailscale serve address that proxies to this server.
  const ts = ['tailscale', '/Applications/Tailscale.app/Contents/MacOS/Tailscale'];
  for (const bin of ts) {
    try {
      let last = null;
      for (const line of execFileSync(bin, ['serve', 'status'], { encoding: 'utf8' }).split('\n')) {
        const u = /^(https:\/\/\S+)/.exec(line);
        if (u) last = u[1];
        else if (last && line.includes(`127.0.0.1:${process.env.PORT ?? 8080}`)) return last.replace(/\/$/, '');
      }
    } catch { /* try the next one */ }
  }
  return local;
}

const win = JSON.parse(execFileSync('osascript', ['-l', 'JavaScript', '-e', JXA, opt.app], { encoding: 'utf8' }));
if (win.error) { console.error(win.error); process.exit(1); }

const headers = { 'x-macremote-key': key };
if (opt.shot) {
  const r = await fetch(`${local}/api/handoff/shot?window=${win.id}`, { headers });
  if (!r.ok) { console.error(`macremote: ${r.status} ${await r.text()}`); process.exit(1); }
  writeFileSync(opt.shot, Buffer.from(await r.arrayBuffer()));
  const px = (v) => Math.round(v * win.scale);
  console.log(`${opt.shot}: ${px(win.bounds.Width)}x${px(win.bounds.Height)} px of ${win.app}'s front window. Pass a spot in these pixels as --rect x,y,w,h.`);
  process.exit(0);
}

const b = win.bounds;
let region = toFrac(b, win.screen);
let mark = null;
if (opt.rect) {
  const n = opt.rect.split(',').map(Number);
  if (n.length !== 4 || n.some((v) => !Number.isFinite(v) || v < 0)) { console.error('--rect wants x,y,w,h'); process.exit(64); }
  const [rx, ry, rw, rh] = n.map((v) => v / win.scale);           // screenshot pixels -> points
  const spot = { X: b.X + rx, Y: b.Y + ry, Width: rw, Height: rh };
  mark = toFrac(spot, win.screen);
  // Zoom to the spot with some of the window around it, so it's clear where it is.
  const padX = Math.max(rw, b.Width * 0.15), padY = Math.max(rh, b.Height * 0.15);
  const X = Math.max(b.X, spot.X - padX), Y = Math.max(b.Y, spot.Y - padY);
  region = toFrac({ X, Y, Width: Math.min(b.X + b.Width, spot.X + rw + padX) - X,
    Height: Math.min(b.Y + b.Height, spot.Y + rh + padY) - Y }, win.screen);
}

let clip = null;
if (opt.clip) {
  clip = readFileSync(0, 'utf8');
  execFileSync('pbcopy', { input: clip });
}

const res = await fetch(`${local}/api/handoff`, {
  method: 'POST',
  headers: { 'content-type': 'application/json', ...headers },
  body: JSON.stringify({ message: opt.message, app: win.app, region, mark }),
});
if (!res.ok) { console.error(`macremote: ${res.status} ${await res.text()}`); process.exit(1); }
const { id, path } = await res.json();
console.log(publicBase() + path);
if (!opt.wait) process.exit(0);

let done = false, expired = false;
while (!done && !expired) {
  try {
    const r = await fetch(`${local}/api/handoff/${id}/wait`, { headers: { 'x-macremote-key': key } });
    ({ done, expired } = await r.json());
  } catch { await new Promise((ok) => setTimeout(ok, 2000)); }
}
if (clip !== null && execFileSync('pbpaste', { encoding: 'utf8' }) === clip) execFileSync('pbcopy', { input: '' });
console.log(done ? 'done' : 'expired');
process.exit(done ? 0 : 2);
