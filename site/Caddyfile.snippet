# Drop-in site block for the shared server. Save as /etc/caddy/sites/phonetopcremote.caddy
# (the main Caddyfile needs one line:  import /etc/caddy/sites/*.caddy)
phonetopcremote.com, www.phonetopcremote.com {
	root * /var/www/phonetopcremote
	try_files {path} {path}.html
	file_server
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
}
